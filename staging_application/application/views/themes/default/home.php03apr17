<script type="text/javascript">	 
	$(window).load(function() {
		$("#fb_like_remove").removeClass("social_remove");
	});
    $(document).ready(function(){
	$(window).fadeThis({		  
	  speed: 1000		  
	});
 
 	$(".faq_tab_outer ul li").each(function() {
		if ($(this).next().length > 0) {
			$(this).addClass("parent");
		}
	});
	
	$(".faq_show_section a").click(function(e) {
		e.preventDefault();
		$(this).toggleClass("active");
		$(".faq_tab_outer").slideToggle("medium");
	});
	adjustMenu();
	
	$("#accordian h3").click(function(){
	$(".parent active").removeClass("active");
		//slide up all the link lists
		$("#accordian ul ul").slideUp();
		$(this).toggleClass("active");
		//slide down the link list below the h3 clicked - only if its closed
		if(!$(this).next().is(":visible"))
		{
			$(this).next().slideDown();
		}
	})
	$("#fb_like_remove").addClass("social_remove");	
	$("#sho").hide();
    $( "#palys" ).click(function() {
    var source="//player.vimeo.com/video/101892616?title=0&amp;byline=0&amp;portrait=0&amp;autoplay=1";
            $('iframe#vdemo').attr('src',source);
            $("#sho").show();
            $('#vfade').show();
        });		
	$( "#palys_client" ).click(function() {
   
    });
    $("#c_info").hide();
    $("#roi").hide();
    });
    $("#popup1").click(function(){
    $("#c_info").show();
    $('body').append('<div id="fade"></div>');
	$('#fade').css({'filter' : 'alpha(opacity=100)'}).fadeIn();
	$('#fade').css({'visibility' : 'visible'});
    });
    $("#bkey").click(function(){
    $("#roi").hide();
    $("#key").show();
    $("#bkey").addClass("active");
    $("#croi").removeClass("active");
    });
    $("#croi").click(function(){
    $("#roi").show();
    $("#key").hide();
    $("#bkey").removeClass("active");
    $("#croi").addClass("active");
    });
    $(document).keyup(function(e) {
        if (e.keyCode == 27) { 
            $('#c_info').hide();
            $('div#fade').remove();
		}
    });
    function hide_req2(){
	$('#c_info').hide();
	$('div#fade').remove();
    }
    function popup_close(popup_block){
    $('#'+popup_block).hide();    
    $('#vfade').hide();
      //var source = "//player.vimeo.com/video/101892616";
      //next SRC attribute clear
      $('iframe#vdemo').attr('src','');
      //callback previous SRC attribute:
      //$('iframe#vdemo').attr('src',source);
    }  
    // Load this when the DOM is ready
    $(function(){
    $('.carousel').carousel();
	
	$('.carousel-control.left').click(function() {
		$('#myCarousel').carousel('prev');
	});

	$('.carousel-control.right').click(function() {
	  $('#myCarousel').carousel('next');
	});
    });	
	new WOW().init();		
	(function(d, s, id) {
	var js, fjs = d.getElementsByTagName(s)[0];
	if (d.getElementById(id)) return;
	js = d.createElement(s); js.id = id;
	js.src = "//connect.facebook.net/en_GB/sdk.js#xfbml=1&version=v2.4";
	fjs.parentNode.insertBefore(js, fjs);
	}(document, 'script', 'facebook-jssdk'));
	function equalHeight(group) {
		tallest = 0;
		group.each(function() {
		thisHeight = $(this).height();
		if(thisHeight > tallest) {
		tallest = thisHeight;
		}
		});
		group.height(tallest);
	}
	$(document).ready(function() {
		equalHeight($(".faq_height"));
	});
</script>
