    define("COMPANY_META_TITLE", $rs['company_meta_title'][0]);
    define("COMPANY_META_KEYWORD", $rs['company_meta_keyword'][0]);
    define("COMPANY_META_DESCRIPTION", $rs['company_meta_description'][0]);
    define("COMPANY_COPYRIGHT", $rs['company_copyrights'][0]);
    define("COMPANY_SITENAME", $rs['company_app_name'][0]);
    define("DEFAULT_UNIT", $rs['default_unit'][0]);
    define("DEFAULT_SKIP_CREDIT_CARD", $rs['skip_credit_card'][0]);
    define("COMPANY_FARE_CALCULATION_TYPE", $rs['fare_calculation_type'][0]); //
    define("COMPANY_CURRENCY", $company_curency_symbol); //eg: $
    define("COMPANY_CURRENCY_FORMAT", $company_curency_code); //eg: USD
    define("TELL_TO_FRIEND_MESSAGE", $rs['company_app_description'][0]);
   // define("CANCELLATION_FARE", $rs['cancellation_fare'][0]);
     define("CANCELLATION_FARE", $result['cancellation_fare_setting']);
    define("COMPANY_FIRST_NAME", $rs['name']);
    define("COMPANY_LAST_NAME", $rs['lastname']);
    define("COMPANY_CONTACT_EMAIL", $rs['email']);
    define("COMPANY_STREET_ADDR", $rs['address']);
    define("COMPANY_LOGIN_CITY", isset($rs['login_city']) ? $rs['login_city'] : DEFAULT_CITY);
    define("COMPANY_LOGIN_STATE", isset($rs['login_state']) ? $rs['login_state'] : DEFAULT_STATE);
    define("COMPANY_LOGIN_COUNTRY", isset($rs['login_country']) ? $rs['login_country'] : DEFAULT_COUNTRY);
    define("CONTACT_EMAIL", COMPANY_CONTACT_EMAIL);
    define("SITE_FAVICON", $rs['company_favicon'][0]);
    if(!empty(COMPANY_LOGIN_CITY) && !empty(COMPANY_LOGIN_STATE) && !empty(COMPANY_LOGIN_COUNTRY)){
        //MongoDB with aggregate process only
		$ops = array(
			array('$unwind' => '$stateinfo'),
			array('$unwind' => '$stateinfo.cityinfo'),
			array('$match' => array('stateinfo.cityinfo.city_id'=>(int)COMPANY_LOGIN_CITY,'stateinfo.cityinfo.city_stateid'=>(int)COMPANY_LOGIN_STATE,'stateinfo.cityinfo.city_countryid'=>(int)COMPANY_LOGIN_COUNTRY)),
			array('$project' => array('_id' => 0,
                    'state_name' => '$stateinfo.state_name', 
                    'city_name' => '$stateinfo.cityinfo.city_name',
                    'zipcode' => '$stateinfo.cityinfo.zipcode',
                    'iso_country_code' => '$iso_country_code',
                )
            )
		);
		$res = $mongodb->aggregate(MDB_CSC,$ops);
		$result = $res['result'];
        define("COMPANY_LOGIN_CITY_NAME", $result[0]['city_name']);
        define("COMPANY_ZIPCODE", $result[0]['zipcode']);
        define("COMPANY_LOGIN_STATE_NAME", $result[0]['state_name']);
        define("COMPANY_LOGIN_ISO_COUNTRYCODE", $result[0]['iso_country_code']);
    }
} else {
    define("COMPANY_SITENAME", SITE_NAME);
    define("COMPANY_NOTIFICATION_TIME", 60);
    define("COMPANY_CUSTOMER_APP_URL", 'https://play.google.com/store/apps/details?id=com.taximobility');
    define("COMPANY_DRIVER_APP_URL", 'https://play.google.com/store/apps/details?id=com.taximobility.driver');
    define('TELL_TO_FRIEND_MESSAGE', $result['tell_to_friend_message']);
    define("DEFAULT_UNIT", $result['default_unit']);
    define("DEFAULT_SKIP_CREDIT_CARD", $result['skip_credit_card']);
    define("COMPANY_CURRENCY", CURRENCY);
    define("CANCELLATION_FARE", $result['cancellation_fare_setting']);
    define("COMPANY_COPYRIGHT", SITE_COPYRIGHT);
    define("CONTACT_EMAIL", SITE_EMAIL_CONTACT);
    define("SITE_FAVICON", $result['site_favicon']);
}
