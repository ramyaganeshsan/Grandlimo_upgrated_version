                'company_app_name' => '$cdetails.companyinfo.company_app_name',
                'driver_app_url' => '$cdetails.companyinfo.driver_app_url',
                'company_api_key' => '$cdetails.companyinfo.company_api_key',
                'company_facebook_key' => '$cdetails.companyinfo.company_facebook_key',
                'company_facebook_secretkey' => '$cdetails.companyinfo.company_facebook_secretkey',
                'company_notification_settings' => '$cdetails.companyinfo.company_notification_settings',
                'company_name' => '$cdetails.companydetails.company_name',
                'header_bgcolor' => '$cdetails.companydetails.header_bgcolor',
                'menu_color' => '$cdetails.companydetails.menu_color',
