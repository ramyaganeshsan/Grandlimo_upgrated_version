                'company_meta_keyword' => '$cdetails.companyinfo.company_meta_keyword',
                'company_meta_description' => '$cdetails.companyinfo.company_meta_description',
                'company_copyrights' => '$cdetails.companyinfo.company_copyrights',
                'default_unit' => '$cdetails.companyinfo.default_unit',
                'skip_credit_card' => '$cdetails.companyinfo.skip_credit_card',
                'fare_calculation_type' => '$cdetails.companyinfo.fare_calculation_type',
                'company_app_description' => '$cdetails.companyinfo.company_app_description',
                'cancellation_fare' => '$cdetails.companyinfo.cancellation_fare',
                'name' => '$name',
                'lastname' => '$lastname',
