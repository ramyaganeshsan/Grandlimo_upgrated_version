	{
		 //MongoDB
    $ops = array(
        array('$match' => array('user_type'=>'A','company_id'=>(int)COMPANY_CID)),
        array(
            '$lookup' => array(
                'from'=>MDB_COMPANY,
                'localField'=> "company_id",
                'foreignField' => "_id",
                'as'=> "cdetails"
            )
        ),
        array('$project' =>
            array('_id' => 0,
                'company_logo' => '$cdetails.companyinfo.company_logo', 
